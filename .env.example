# ─── Core ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://foodshare:foodshare@localhost:5433/foodshare"
APP_URL="http://localhost:3000"
# 32+ random chars. Used to sign local upload URLs and other HMACs.
APP_SECRET="change-me-to-a-long-random-string-0123456789"
# Bearer token required by /api/cron (external schedulers call this).
CRON_SECRET="change-me-cron"
# Run the job loop inside the Node process (single VPS / container). Set false on serverless.
ENABLE_INTERNAL_CRON="true"

# ─── Region & money ────────────────────────────────────────────────────
NEXT_PUBLIC_CURRENCY="INR"           # INR | USD | EUR | GBP
NEXT_PUBLIC_DEFAULT_LAT="28.6139"
NEXT_PUBLIC_DEFAULT_LNG="77.2090"

# ─── Payments: mock | razorpay | stripe ────────────────────────────────
PAYMENT_PROVIDER="mock"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ─── Storage: local | s3 (Cloudflare R2 / any S3) ──────────────────────
STORAGE_DRIVER="local"
S3_ENDPOINT=""                       # https://<account>.r2.cloudflarestorage.com
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""                     # https://cdn.example.org (R2 public bucket / custom domain)

# ─── Email (any SMTP: Resend, Brevo, SES, Mailpit in dev) ──────────────
SMTP_URL="smtp://localhost:1025"
EMAIL_FROM="FoodShare <no-reply@foodshare.local>"

# ─── Web Push (npm run vapid) ──────────────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@foodshare.local"

# ─── Maps & geocoding ──────────────────────────────────────────────────
NEXT_PUBLIC_MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"
NEXT_PUBLIC_MAP_ATTRIBUTION="&copy; OpenStreetMap contributors"
GEOCODER_URL="https://nominatim.openstreetmap.org/search"
GEOCODER_CONTACT="admin@foodshare.local"
